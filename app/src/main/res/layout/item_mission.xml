<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:layout_marginBottom="13dp" android:padding="18dp" android:background="@drawable/bg_card">
    <TextView android:id="@+id/itemNumber" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="M01" android:textStyle="bold" android:textColor="@color/rose" android:textSize="13sp"/>
    <TextView android:id="@+id/itemTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="제목" android:textStyle="bold" android:textColor="@color/night_ink" android:textSize="19sp"/>
    <TextView android:id="@+id/itemSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="장소" android:textColor="@color/subtle_ink" android:textSize="13sp"/>
    <TextView android:id="@+id/itemState" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="13dp" android:text="탐색하기" android:textStyle="bold" android:textColor="@color/rose" android:textSize="14sp"/>
</LinearLayout>
