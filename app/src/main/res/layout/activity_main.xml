<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/warm_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="26dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="FIRST STEP  ·  2026"
            android:textColor="@color/rose" android:textStyle="bold" android:letterSpacing="0.1" android:textSize="13sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="첫발자국"
            android:textStyle="bold" android:textColor="@color/night_ink" android:textSize="40sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="학교 안내를 직접 걷는 경험으로.\n다섯 개의 기억을 모아 나만의 캠퍼스를 완성해요."
            android:textColor="@color/subtle_ink" android:textSize="16sp" android:lineSpacingExtra="6dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="35dp" android:background="@drawable/bg_card"
            android:padding="24dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="나의 탐방 진행도" android:textSize="15sp" android:textColor="@color/subtle_ink"/>
            <TextView android:id="@+id/textProgress" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="기억 조각 0 / 5개" android:textStyle="bold" android:textColor="@color/night_ink" android:textSize="23sp"/>
            <ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="9dp"
                android:layout_marginTop="20dp" android:max="100" android:progress="0" android:progressTint="@color/rose"/>
        </LinearLayout>
        <Button android:id="@+id/buttonStart" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="28dp" android:background="@drawable/bg_button" android:text="탐방 시작하기"
            android:textSize="18sp" android:textAllCaps="false" android:textColor="@color/pure_white"/>
        <Button android:id="@+id/buttonMap" android:layout_width="match_parent" android:layout_height="55dp"
            android:layout_marginTop="12dp" android:text="캠퍼스 안내도 (구조 시안)" android:textAllCaps="false"/>
        <Button android:id="@+id/buttonCollection" android:layout_width="match_parent" android:layout_height="55dp"
            android:layout_marginTop="6dp" android:text="나의 도감" android:textAllCaps="false"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:text="1차 개발본: 위치·AR 연동 전 단계입니다. 센서 미션은 M02/M05에서 확인할 수 있습니다."
            android:textColor="@color/subtle_ink" android:textSize="12sp" android:gravity="center"/>
    </LinearLayout>
</ScrollView>
